        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "requests": {},
        "exec": [
          "let response = pm.response.json();\r",
          "\r",
          "// Save token\r",
          "if (response.base64EncodedAuthenticationKey) {\r",
          "\r",
          "    pm.environment.set(\r",
          "        \"token\",\r",
          "        response.base64EncodedAuthenticationKey\r",
          "    );\r",
          "\r",
          "    pm.environment.set(\r",
          "        \"authorization\",\r",
          "        \"Basic \" + response.base64EncodedAuthenticationKey\r",
          "    );\r",
          "\r",
          "    console.log(\"Authorization Saved Successfully\");\r",
          "}"
        ]
      }
    }
